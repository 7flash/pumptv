{
  "name": "slopstream",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tradjs serve",
    "worker": "bun src/worker.ts",
    "dev:all": "sh -c 'bun src/worker.ts & worker=$!; trap \"kill $worker 2>/dev/null || true\" EXIT INT TERM; tradjs serve'",
    "build": "tradjs build",
    "start": "tradjs serve 3000"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "measure-fn": "^3.11.2",
    "sqlite-zod-orm": "^3.33.0",
    "tradjs": "^4.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0",
    "@types/ws": "^8.18.0"
  }
}
