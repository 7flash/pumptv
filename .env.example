FAL_KEY=

# AI showrunner. jsx-ai auto-routes provider/auth from the model name.
# Gemini: GEMINI_API_KEY, OpenAI: OPENAI_API_KEY, Anthropic: ANTHROPIC_API_KEY, DeepSeek: DEEPSEEK_API_KEY.
SLOP_SHOWRUNNER_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Post-render reality reconciliation. Prompt composition still uses jsx-ai, while
# the sampled frames are sent through fal's OpenRouter Vision endpoint.
SLOP_RECONCILE_VISION=1
SLOP_RECONCILER_MODEL=google/gemini-2.5-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
SLOP_DB_PATH=.data/slopstream.sqlite
SLOP_ROOM=main
SLOP_RESOLUTION=768P
SLOP_ADMIN_TOKEN=
# Adaptive rolling reserve. Target is intentionally capped at three 5s clips.
SLOP_MIN_CLIPS_AHEAD=2
SLOP_TARGET_CLIPS_AHEAD=3
SLOP_BUFFER_SAFETY_MARGIN_MS=1000
SLOP_LEASE_TTL_MS=30000

# Replay/archive + generation recovery. Keep 0 for maximum throughput, or add
# intentional breathing room between successful H3 renders.
SLOP_TIMELINE_WINDOW=64
SLOP_MIN_GENERATION_INTERVAL_MS=0
SLOP_FUNDS_RETRY_BASE_MS=30000
SLOP_FUNDS_RETRY_MAX_MS=900000
SLOP_PROVIDER_RETRY_BASE_MS=3000
SLOP_PROVIDER_RETRY_MAX_MS=60000

# Scene arbitration. Ballot N+1 stays open while clip N is rendering. The worker
# adapts the safe close deadline from measured p90 end-to-end generation latency.
SLOP_PROMPT_WINDOW_MS=4500
SLOP_GENERATION_LEAD_MS=4500
SLOP_MAX_PROPOSALS_PER_ROUND=40

# Pump.fun live-chat ingestion. Use the token/mint address from
# https://pump.fun/livechat/<mint>. Leave the mint blank to disable it.
SLOP_PUMPFUN_MINT=
# !next <idea> proposes a candidate and automatically casts that wallet's vote.
# Set this empty to treat every non-vote chat message as a proposal.
SLOP_PUMPFUN_PREFIX=!next
# !vote <candidate-id> moves the wallet/username's one vote in the current round.
SLOP_PUMPFUN_VOTE_PREFIX=!vote
SLOP_PUMPFUN_LEASE_TTL_MS=30000
SLOP_PUMPFUN_LEASE_POLL_MS=1000
SLOP_PUMPFUN_MAX_PROMPT_LENGTH=500
# Optional per-wallet/username command throttle. 0 accepts every valid command.
SLOP_PUMPFUN_USER_COOLDOWN_MS=0

MEASURE_TIMESTAMPS=1
